# Copy this file to ".env" and fill in the two values from your Supabase
# project (dashboard > Connect, or Settings > API Keys).
#
# Both values are safe to ship in the browser: the publishable key only lets a
# visitor do what the row-level security policies allow. Never put a "secret"
# or "service_role" key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
